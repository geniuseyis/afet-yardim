{
  "name": "afet-yardim-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "migrate:users:pii:dry": "node scripts/migrate-users-pii-to-hash.js",
    "migrate:users:pii:apply": "node scripts/migrate-users-pii-to-hash.js --apply",
    "migrate:users:pii:apply:strip": "node scripts/migrate-users-pii-to-hash.js --apply --strip-raw",
    "test": "node --test lib/**/*.test.js",
    "test:emulator": "node --test lib/**/*.emulator.test.js",
    "test:emulator:exec": "npm run build && firebase emulators:exec --project demo-afetyardim --only functions,firestore,auth \"npm run test:emulator\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.4.0",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.6.3"
  }
}
