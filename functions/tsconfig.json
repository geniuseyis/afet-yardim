{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "rootDir": "./src",
    "outDir": "lib",
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": false
  },
  "compileOnSave": true,
  "include": [
    "src"
  ],
  "extends": "expo/tsconfig.base"
}
